      "parameters": {
        "jsCode": "// Builds the ticket: ID, category, priority and a template response (no AI credentials needed).\nconst b = $input.first().json.body || {};\nconst name = String(b.customer_name).trim();\nconst email = String(b.customer_email).trim();\nconst desc = String(b.issue_description).trim();\nconst text = desc.toLowerCase();\nconst has = (words) => words.some((w) => text.includes(w));\n\nconst categories = ['Payment Issues', 'Technical Issues', 'Account Issues', 'General Queries'];\nlet category = categories.find((c) => c.toLowerCase() === String(b.issue_category || '').trim().toLowerCase());\nif (!category) {\n  if (has(['payment', 'refund', 'charge', 'invoice', 'billing', 'transaction', 'deducted', 'card', 'upi'])) category = 'Payment Issues';\n  else if (has(['password', 'login', 'log in', 'account', 'hacked', 'otp', 'unauthorized', 'username', 'sign in'])) category = 'Account Issues';\n  else if (has(['error', 'bug', 'crash', 'not working', 'down', 'outage', 'slow', 'broken', 'fail', 'unavailable'])) category = 'Technical Issues';\n  else category = 'General Queries';\n}\n\nconst paymentFailure = category === 'Payment Issues' && has(['fail', 'declined', 'deducted', 'double', 'twice', 'stuck', 'not received']);\nconst security = has(['hacked', 'unauthorized', 'compromised', 'stolen', 'phishing', 'suspicious', 'breach', 'security']);\nconst outage = has(['outage', 'urgent', 'down for', 'service is down', 'site is down', 'cannot access anything']);\nlet priority = 'LOW';\nif (paymentFailure || security || outage) priority = 'HIGH';\nelse if (category !== 'General Queries') priority = 'MEDIUM';\n\nconst templates = {\n  'Payment Issues': 'We are sorry about the trouble with your payment. Our billing team is reviewing your transaction and will confirm the next steps, including any refund, shortly.',\n  'Technical Issues': 'Thank you for reporting this technical problem. Our engineers are investigating and we will update you as soon as we have a fix or workaround.',\n  'Account Issues': 'Thank you for contacting us about your account. For your safety, please do not share your password with anyone. Our account team is looking into this and will help you regain full access.',\n  'General Queries': 'Thank you for reaching out. We have received your query and a member of our team will get back to you with the information you need.',\n};\nconst sla = { HIGH: 'within 1 hour', MEDIUM: 'within 24 hours', LOW: 'within 2-3 business days' };\nconst response = 'Dear ' + name + ', ' + templates[category] + ' You can expect a follow-up ' + sla[priority] + '. Kind regards, Customer Support Team';\n\nconst ticket_id = 'TKT-' + Date.now().toString(36).toUpperCase() + '-' + Math.random().toString(36).slice(2, 6).toUpperCase();\n\nreturn [{ json: {\n  ticket_id,\n  customer_name: name,\n  customer_email: email,\n  issue_description: desc,\n  category,\n  priority,\n  status: 'Open',\n  generated_response: response,\n  created_date: new Date().toISOString(),\n} }];"
      },
